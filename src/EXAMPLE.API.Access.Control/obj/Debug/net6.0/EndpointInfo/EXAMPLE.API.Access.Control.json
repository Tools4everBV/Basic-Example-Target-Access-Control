{
  "openapi": "3.0.4",
  "info": {
    "title": "HelloID Access Control target system example API",
    "description": "This example API specifies example calls for developing a new API for an Access Control System that will be used for user provisioning from HelloID.<br>Our Starting point, we grant permissions to user accounts and the permissions assigned to a user will be applied to the accessKeys assigned to that user.</br><br>See the Github repo linked below to download the source code.</br>",
    "contact": {
      "name": "Tools4everBV Github",
      "url": "https://github.com/orgs/Tools4everBV/"
    },
    "version": "1.0"
  },
  "paths": {
    "/api/AccessKeyAssignments": {
      "get": {
        "tags": [
          "AccessKeyAssignments"
        ],
        "summary": "Get AccessKeyAssignments for all users (optional)",
        "description": "<h2>Implementation notes</h2>\r\n            This can be userful for reporting, but is generally not required for HelloID because the Accesskeys are typically not assigned by HelloId",
        "operationId": "GetAllAccessKeyAssignments",
        "responses": {
          "200": {
            "description": "Returns the list of all AccessKeyAssignments",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AccessKeyAssignment"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "AccessKeyAssignments"
        ],
        "summary": "Add AccessKeyAssignment (optional test)",
        "description": "<h2>Implementation notes</h2>\r\n            We will use this action only for testing this example API, generally we do not assign access keys to users in helloID \r\n            \r\n</br>\r\n            Example:\r\n              \r\n                POST /accesskeyassignments\r\n                {\r\n                   \"accessKeyId\": 1,\r\n                   \"userId\": 1\r\n                }",
        "operationId": "AddAccessKeyAssignment",
        "requestBody": {
          "description": "The authorization that will be added.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccessKeyAssignment"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessKeyAssignment"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "AccessKeyAssignments"
        ],
        "summary": "Delete AccessKeyAssignment",
        "description": "<h2>Implementation notes</h2>\r\n            We will use this action when an AccessKey is revoked from a user. This action does not require a response. A [204 No Content] is sufficient.",
        "operationId": "DeleteAccessKeyAssignmentByValue",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "accessKeyId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/AccessKeyAssignments/{userId}/Accesskeys": {
      "get": {
        "tags": [
          "AccessKeyAssignments"
        ],
        "summary": "Get all assigned Access keys for a specific user",
        "description": "<h2>Implementation notes</h2>\r\n            This returns all Access Keys currently assigned to the given user.\r\n            \r\n</br>\r\n            Useful when validating which permissions/roles the user has at a given moment.",
        "operationId": "GetAccessKeysByUserId",
        "parameters": [
