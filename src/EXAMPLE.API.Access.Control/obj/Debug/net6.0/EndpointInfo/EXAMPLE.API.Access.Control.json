                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Users"
        ],
        "summary": "Delete user (by id)",
        "description": "<h2>Implementation notes</h2>\r\n            This action does not require a response. A [204 No Content] is sufficient.",
        "operationId": "DeleteUser",
        "parameters": [
          {
            "name": "id",
