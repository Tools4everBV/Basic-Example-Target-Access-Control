          },
          "401": {
            "description": "Authentication failed or was not provided.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Add user",
        "description": "<h2>Implementation notes</h2>\r\n            Adds a new user account to the target system. The response must contain the internal database ID since this is the key we correlate on and will be used for consecutive requests to the target system. Therefore, the `id` field is enlisted in the user schema.\r\n            \r\n</br>\r\n            Example:\r\n                \r\n                POST /Users\r\n                {\r\n                   \"employeeId\": \"1000000\",\r\n                   \"firstName\": \"John\",\r\n                   \"lastName\": \"Doe\",\r\n                   \"email: \"JDoe@enyoi\",\r\n                   \"active\": \"false\"\r\n                }",
        "operationId": "AddUser",
        "requestBody": {
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Users/ByEmployeeId/{employeeId}": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get user (by EmployeeId)",
        "description": "<h2>Implementation notes</h2>\r\n            Before we add a user account to the target application, we need to validate if that user account exists.\r\n            \r\n</br>\r\n            Initially, the internal database ID is not known to us. Therefore, we prefer to validate this using the `EmployeeId` since this is unique and available in HelloID.\r\n            \r\n</br>\r\n            We only need to retrieve the user account using the `employeeId` in our initial create event. For all other events we will use the internal database ID. The `database ID` is the also key we correlate on in our create event.",
        "operationId": "GetUserByEmployeeId",
        "parameters": [
          {
            "name": "employeeId",
            "in": "path",
            "description": "",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Users/{id}": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get user (by id)",
        "description": "<h2>Implementation notes</h2>\r\n            Before we update a particular user account, we need to validate if that user account still exists.\r\n            \r\n</br>\r\n            Validating if the user account exists is an integral part in all our lifecycle events because the user account might be <em>unintentionally</em> deleted. In which case the lifecycle event will fail. \r\n            For example: when we want to enable the user account on the day the contract takes effect.\r\n            \r\n</br>",
        "operationId": "GetUserById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Users"
        ],
        "summary": "Update user (by id)",
        "description": "<h2>Implementation notes</h2>\r\n            To update a user account we prefer to see an update call in the form of a patch. Which means that we only update the values that have been changed.\r\n            \r\n</br><em>In this case the patch method is implemented using <a href=\"https://jsonpatch.com/\">JSON Patch</a>. Note that this might not have to be the best solution for your application.</em>\r\n</br>\r\n            Example:\r\n              \r\n                PATCH /Users/:id\r\n                [  \r\n                    {\r\n                        \"op\": \"replace\",\r\n                        \"path\": \"lastName\",\r\n                        \"value\": \"Jane\"s\r\n                    }\r\n                ]",
        "operationId": "PatchUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Operation"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
